#include "/Engine/Public/Platform.ush"
#include "/Plugin/MabaUpscaler3/MabaTsr.ush"

Texture2D MabaShown;
float4 MabaOutInfo;      // xy = output size, zw = 1 / output size
float4 MabaOutputRect;   // xy = output rect min in pixels
float4 MabaPresent;      // x = sharpen strength

void MainPS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	OutColor = MabaTsrPresent(MabaShown, SvPosition.xy - MabaOutputRect.xy, MabaOutInfo, MabaPresent.x);
}